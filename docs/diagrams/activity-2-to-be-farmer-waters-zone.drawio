 kit status" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="585.0" y="330.0" width="250" height="60" as="geometry"/></mxCell><mxCell id="n9" value="Kit&lt;br&gt;connected?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="315.0" y="428.0" width="170" height="84" as="geometry"/></mxCell><mxCell id="n10" value="See 'Not connected' and how to get help" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="60.0" y="435.0" width="210" height="70" as="geometry"/></mxCell><mxCell id="n11" value="" style="rhombus;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="380" y="560" width="40" height="40" as="geometry"/></mxCell><mxCell id="n12" value="Press Water now" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="300.0" y="660.0" width="200" height="60" as="geometry"/></mxCell><mxCell id="n13" value="Send start command, capped at the zone's run limit" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="585.0" y="765.0" width="250" height="70" as="geometry"/></mxCell><mxCell id="n14" value="Switch pump on and confirm start" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="915.0" y="880.0" width="250" height="60" as="geometry"/></mxCell><mxCell id="n15" value="Start&lt;br&gt;confirmed?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="625.0" y="978.0" width="170" height="84" as="geometry"/></mxCell><mxCell id="n16" value="Try&lt;br&gt;again?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="315.0" y="978.0" width="170" height="84" as="geometry"/></mxCell><mxCell id="n17" value="" style="rhombus;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="145" y="1066.0" width="40" height="40" as="geometry"/></mxCell><mxCell id="n18" value="Run pump (stops by itself at the run limit, or after 3 min without server contact)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="905.0" y="1088.0" width="270" height="84" as="geometry"/></mxCell><mxCell id="n19" value="Stop&lt;br&gt;early?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="315.0" y="1198.0" width="170" height="84" as="geometry"/></mxCell><mxCell id="n20" value="Press Stop" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="280.0" y="1320.0" width="240" height="60" as="geometry"/></mxCell><mxCell id="n21" value="" style="rhombus;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1020" y="1440" width="40" height="40" as="geometry"/></mxCell><mxCell id="n22" value="Switch pump off and confirm stop" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="915.0" y="1540.0" width="250" height="60" as="geometry"/></mxCell><mxCell id="n23" value="Record the watering in History" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="585.0" y="1650.0" width="250" height="60" as="geometry"/></mxCell><mxCell id="n24" value="See 'Kit confirmed stop'" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="280.0" y="1760.0" width="240" height="60" as="geometry"/></mxCell><mxCell id="n25" value="" style="rhombus;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="145" y="1770" width="40" height="40" as="geometry"/></mxCell><mxCell id="n26" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="148" y="1883" width="34" height="34" as="geometry"/></mxCell><mxCell id="n51" value="&lt;b&gt;Assumptions&lt;/b&gt;&lt;br&gt;• The farmer is signed in and the zone has a commissioned kit.&lt;br&gt;• The zone is in Manual mode. An Automatic zone starts at 'Send start command' from the FAO-56 recommendation, then follows the same flow.&lt;br&gt;• No flow meter: 'confirmed' means the kit switched the pump, not that flow was measured.&lt;br&gt;• The kit ignores a repeated command, so trying again never waters twice." style="shape=note;whiteSpace=wrap;html=1;size=16;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;fontFamily=Helvetica;fillColor=#FFF8DC;strokeColor=#B8A04A;" vertex="1" parent="1"><mxGeometry x="900" y="140" width="280" height="250" as="geometry"/></mxCell><mxCell id="n27" value="" style="endArrow=open;endFill=0;endSize=10;strokeWidth=1.5;strokeColor=#222222;edgeStyle=none;html=1;rounded=0;exitX=0.5000;exitY=1.0000;