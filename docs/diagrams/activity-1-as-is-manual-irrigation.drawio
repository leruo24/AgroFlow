<mxfile host="app.diagrams.net"><diagram name="As-Is - Manual irrigation" id="activity-1-as-is-manual-irrigation.drawio"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1020" pageHeight="1290" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="As-Is activity diagram: manual irrigation (before AgroFlow)" style="text;html=1;fontSize=18;fontStyle=1;fontFamily=Helvetica;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="940" height="36" as="geometry"/></mxCell><mxCell id="n3" value="Farmer" style="swimlane;html=1;startSize=36;horizontal=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontStyle=1;fontSize=15;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="620" height="1190" as="geometry"/></mxCell><mxCell id="n4" value="Irrigation equipment" style="swimlane;html=1;startSize=36;horizontal=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontStyle=1;fontSize=15;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="660" y="70" width="320" height="1190" as="geometry"/></mxCell><mxCell id="n5" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="484" y="124" width="32" height="32" as="geometry"/></mxCell><mxCell id="n6" value="Walk to the field" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="380.0" y="220.0" width="240" height="60" as="geometry"/></mxCell><mxCell id="n7" value="" style="rhombus;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="480" y="340" width="40" height="40" as="geometry"/></mxCell><mxCell id="n8" value="Inspect soil by hand or eye" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="380.0" y="440.0" width="240" height="60" as="geometry"/></mxCell><mxCell id="n9" value="Soil moist&lt;br&gt;enough?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="415.0" y="538.0" width="170" height="84" as="geometry"/></mxCell><mxCell id="n10" value="Water already&lt;br&gt;running?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="115.0" y="538.0" width="170" height="84" as="geometry"/></mxCell><mxCell id="n11" value="Close valve / stop pump by hand" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="80.0" y="660.0" width="240" height="60" as="geometry"/></mxCell><mxCell id="n12" value="" style="rhombus;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="180" y="780" width="40" height="40" as="geometry"/></mxCell><mxCell id="n13" value="Leave the field" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="80.0" y="880.0" width="240" height="60" as="geometry"/></mxCell><mxCell id="n14" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="183" y="1003" width="34" height="34" as="geometry"/></mxCell><mxCell id="n15" value="Check the weather (phone or sky)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="380.0" y="660.0" width="240" height="60" as="geometry"/></mxCell><mxCell id="n16" value="Rain&lt;br&gt;expected?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="415.0" y="758.0" width="170" height="84" as="geometry"/></mxCell><mxCell id="n17" value="Open valve / start pump by hand" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="380.0" y="880.0" width="240" height="60" as="geometry"/></mxCell><mxCell id="n18" value="Supply water to the crops" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="700.0" y="990.0" width="240" height="60" as="geometry"/></mxCell><mxCell id="n19" value="Wait and watch" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="380.0" y="1100.0" width="240" height="60" as="geometry"/></mxCell><mxCell id="n37" value="&lt;b&gt;Assumptions&lt;/b&gt;&lt;br&gt;• No sensors and no recorded data.&lt;br&gt;• Decisions rely on the farmer's judgement and a general weather check.&lt;br&gt;• The farmer must be in the field to start, watch and stop watering.&lt;br&gt;• No record is kept of water used." style="shape=note;whiteSpace=wrap;html=1;size=16;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;fontFamily=Helvetica;fillColor=#FFF8DC;strokeColor=#B8A04A;" vertex="1" parent="1"><mxGeometry x="50" y="1080" width="320" height="170" as="geometry"/></mxCell><mxCell id="n20" value="" style="endArrow=open;endFill=0;endSize=10;strokeWidth=1.5;strokeColor=#222222;edgeStyle=none;html=1;rounded=0;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source