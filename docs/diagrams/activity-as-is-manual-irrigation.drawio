<mxfile host="app.diagrams.net"><diagram name="As-Is – Manual irrigation" id="activity-as-is-manual-irrigation.drawio"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="760" pageHeight="1500" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Farmer" style="swimlane;html=1;startSize=30;horizontal=1;fillColor=#F5F5F5;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="300" height="1380" as="geometry"/></mxCell><mxCell id="c2" value="Irrigation equipment" style="swimlane;html=1;startSize=30;horizontal=1;fillColor=#F5F5F5;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="340" y="40" width="300" height="1380" as="geometry"/></mxCell><mxCell id="c3" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="175" y="100" width="30" height="30" as="geometry"/></mxCell><mxCell id="c4" value="Walk to the field" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fontSize=11;" vertex="1" parent="1"><mxGeometry x="90" y="180" width="200" height="50" as="geometry"/></mxCell><mxCell id="c5" value="" style="rhombus;whiteSpace=wrap;html=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="170" y="275" width="40" height="40" as="geometry"/></mxCell><mxCell id="c6" value="Inspect soil by hand / eye" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fontSize=11;" vertex="1" parent="1"><mxGeometry x="90" y="360" width="200" height="50" as="geometry"/></mxCell><mxCell id="c7" value="Soil moist enough?" style="rhombus;whiteSpace=wrap;html=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="120" y="440" width="140" height="70" as="geometry"/></mxCell><mxCell id="c8" value="Water already running?" style="rhombus;whiteSpace=wrap;html=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="120" y="530" width="140" height="70" as="geometry"/></mxCell><mxCell id="c9" value="Check weather (phone