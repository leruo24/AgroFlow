<mxfile host="app.diagrams.net"><diagram name="To-Be - Admin: enquiry to live kit" id="activity-3-to-be-enquiry-to-live-kit.drawio"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1480" pageHeight="2720" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="To-Be activity diagram 2: from farmer enquiry to a live kit" style="text;html=1;fontSize=18;fontStyle=1;fontFamily=Helvetica;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="1400" height="36" as="geometry"/></mxCell><mxCell id="n3" value="Farmer" style="swimlane;html=1;startSize=36;horizontal=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontStyle=1;fontSize=15;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="300" height="2610" as="geometry"/></mxCell><mxCell id="n4" value="Admin (staff)" style="swimlane;html=1;startSize=36;horizontal=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontStyle=1;fontSize=15;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="340" y="70" width="300" height="2610" as="geometry"/></mxCell><mxCell id="n5" value="AgroFlow system" style="swimlane;html=1;startSize=36;horizontal=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontStyle=1;fontSize=15;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="640" y="70" width="320" height="2610" as="geometry"/></mxCell><mxCell id="n6" value="Installer" style="swimlane;html=1;startSize=36;horizontal=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontStyle=1;fontSize=15;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="960" y="70" width="480" height="2610" as="geometry"/></mxCell><mxCell id="n7" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="174" y="124" width="32" height="32" as="geometry"/></mxCell><mxCell id="n8" value="Request a call (website enquiry form)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="70.0" y="220.0" width="240" height="60" as="geometry"/></mxCell><mxCell id="n9" value="Record enquiry and notify staff" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="680.0" y="330.0" width="240" height="60" as="geometry"/></mxCell><mxCell id="n10" value="Claim the enquiry and call the farmer" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="370.0" y="440.0" width="240" height="60" as="geometry"/></mxCell><mxCell id="n11" value="Onboard farmer: contact, farm location, zones" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="370.0" y="545.0" width="240" height="70" as="geometry"/></mxCell><mxCell id="n12" value="Create account with temporary password; farm 'Awaiting installation'" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="670.0" y="648.0" width="260" height="84" as="geometry"/></mxCell><mxCell id="n13" value="Hand over login details" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="370.0" y="770.0" width="240" height="60" as="geometry"/></mxCell><mxCell id="n14" value="Sign in and set own password" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="70.0" y="880.0" width="240" height="60" as="geometry"/></mxCell><mxCell id="n15" value="Complete 4 tasks: preferences, farm, water, crops" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="70.0" y="985.0" width="240" height="70" as="geometry"/></mxCell><mxCell id="n16" value="All details&lt;br&gt;known?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="105.0" y="1088.0" width="170" height="84" as="geometry"/></mxCell><mxCell id="n17" value="Follow up details marked 'I don't know'" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="370.0" y="1095.0" width="240" height="70" as="geometry"/></mxCell><mxCell id="n18" value="" style="rhombus;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="470" y="1220" width="40" height="40" as="geometry"/></mxCell><mxCell id="n19" value="Book first installation (date, installer)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="370.0" y="1315.0" width="240" height="70" as="geometry"/></mxCell><mxCell id="n20" value="Create one-time enrollment code (24 h)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="670.0" y="1430.0" width="260" height="60" as="geometry"/></mxCell><mxCell id="n21" value="Connect kit to Wi-Fi and enter the code" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="980.0" y="1540.0" width="260" height="60" as="geometry"/></mxCell><mxCell id="n22" value="Link the kit to the zone" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="670.0" y="1650.0" width="260" height="60" as="geometry"/></mxCell><mxCell id="n23" value="Calibrate soil sensor (wet / dry) and measure flow rate" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="980.0" y="1755.0" width="260" height="70" as="geometry"/></mxCell><mxCell id="n24" value="" style="rhombus;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1090" y="1880" width="40" height="40" as="geometry"/></mxCell><mxCell id="n25" value="Test start and stop" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="980.0" y="1980.0" width="260" height="60" as="geometry"/></mxCell><mxCell id="n26" value="Kit confirmed&lt;br&gt;both?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1020.0" y="2078.0" width="180" height="84" as="geometry"/></mxCell><mxCell id="n27" value="Fix wiring and retry" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1245.0" y="2090.0" width="170" height="60" as="geometry"/></mxCell><mxCell id="n28" value="Commission the zone" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="980.0" y="2200.0" width="260" height="60" as="geometry"/></mxCell><mxCell id="n29" value="Mark zone Live; offer automatic watering" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="670.0" y="2305.0" width="260" height="70" as="geometry"/></mxCell><mxCell id="n30" value="Turn on automatic&lt;br&gt;watering?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="95.0" y="2405.0" width="190" height="90" as="geometry"/></mxCell><mxCell id="n31" value="Set zone to Automatic" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="670.0" y="2530.0" width="260" height="60" as="geometry"/></mxCell><mxCell id="n32" value="" style="rhombus;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="170" y="2540" width="40" height="40" as="geometry"/></mxCell><mxCell id="n33" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="173" y="2653" width="34" height="34" as="geometry"/></mxCell><mxCell id="n63" value="&lt;b&gt;Assumptions&lt;/b&gt;&lt;br&gt;• The enquiry comes from the public website; the farmer has a phone with internet.&lt;br&gt;• New zones always start in Manual mode.&lt;br&gt;• A zone is commissioned only after real wet / dry readings, a measured flow rate and a start and stop confirmed by the kit.&lt;br&gt;• Telegram is for farmers only; staff never receive Telegram messages.&lt;br&gt;• Payments are handled outside the system." style="shape=note;whiteSpace=wrap;html=1;size=16;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;fontFamily=Helvetica;fillColor=#FFF8DC;strokeColor=#B8A04A;" vertex="1" parent="1"><mxGeometry x="990" y="140" width="420" height="210" as="geometry"/></mxCell><mxCell id="n34" value="" style="endArrow=open;endFill=0;endSize=10;strokeWidth=1.5;strokeColor=#222222;edgeStyle=none;html=1;rounded=0;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="n7" target="n8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n35" value="" style="endArrow=open;endFill=0;endSize=10;strokeWidth=1.5;strokeColor=#222222;edgeStyle=none;html=1;rounded=0;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="n8" target="n9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="800.0" y="250.0"/></Array></mxGeometry></mxCell><mxCell id="n36" value="" style="endArrow=open;endFill=0;endSize=10;strokeWidth=1.5;strokeColor=#222222;edgeStyle=none;html=1;rounded=0;exitX=0.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="n9" target="n10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="490.0" y="360.0"/></Array></mxGeometry></mxCell><mxCell id="n37" value="" style="endArrow=open;endFill=0;endSize=10;strokeWidth=1.5;strokeColor=#222222;edgeStyle=none;html=1;rounded=0;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="n10" target="n11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n38" value="" style="endArrow=open;endFill=0;endSize=10;strokeWidth=1.5;strokeColor=#222222;edgeStyle=none;html=1;rounded=0;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="n11" target="n12"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="800.0" y="580.0"/></Array></mxGeometry></mxCell><mxCell id="n39" value="" style="endArro