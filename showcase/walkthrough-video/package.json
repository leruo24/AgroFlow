{
  "name": "agroflow-system-walkthrough",
  "private": true,
  "type": "module",
  "description": "AgroFlow system walkthrough video (HyperFrames). Isolated from the AgroFlow apps.",
  "scripts": {
    "dev": "npx --yes hyperframes@0.8.137 preview",
    "check": "npx --yes hyperframes@0.8.137 check",
    "render": "npx --yes hyperframes@0.8.137 render -o renders/agroflow-system-walkthrough.mp4",
    "capture:admin": "node capture/admin-capture.mjs assets/admin",
    "capture:mobile": "node capture/mobile-capture.mjs assets/mobile"
  },
  "devDependencies": {
    "gsap": "3.14.2",
    "hyperframes": "0.8.137"
  }
}
