# .NET build output (backend/AgroFlow.Domain, backend/AgroFlow.Api) -
# regenerated by `dotnet build`/`dotnet run`, never source.
[Bb]in/
[Oo]bj/
node_modules/

# Firmware credentials - real values live here, created from secrets.example.h
# before flashing. AgroFlow.Api's secrets are in .NET user-secrets, not a file.
hardware/**/secrets.h

# Compiled firmware images for over-the-air updates. Built with arduino-cli
# (esp32:esp32:esp32) from hardware/esp32/AgroFlowIrrigationNode and uploaded
# to whatever Firmware:DownloadUrl points at - a build artefact, not source.
hardware/esp32/build/
# Environment secrets
.env
.env.*
!.env.example

# Expo generated files
.expo/

# Supabase local CLI state
supabase/.temp/

# Build and test output
dist/
[Bb]uild/
web-build/
coverage/
[Tt]est[Rr]esults/
test-results/
playwright-report/
blob-report/
*.log

# Video and archives. The loading animations are app assets and stay tracked.
*.mp4
*.mov
*.zip
!apps/mobile/assets/media/agroflow-loading.mp4
!apps/web/admin/public/media/agroflow-loading.mp4
!apps/mobile/public/media/agroflow-loading-v2.mp4

# Firmware credentials anywhere, not only under hardware/
secrets.h

# OS junk
.DS_Store
Thumbs.db
