<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>48c8db6b-2259-41c3-b8c6-bdee2caa015f</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Same version as AgroFlow.Domain/AgroFlow.Domain.csproj - direct Postgres
         access, matching the existing Npgsql-based data-access pattern rather than
         introducing a Supabase REST/HTTP client. AddNpgsqlDataSource (used in
         Program.cs) lives in the separate DependencyInjection package, not the
         core driver. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.11" />
    <PackageReference Include="MQTTnet" Version="5.2.0.1603" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Npgsql.DependencyInjection" Version="10.0.3" />
    <PackageReference Include="QuestPDF" Version="2026.9.0" />
    <!-- ML.NET for the soil moisture forecast and fault checks (Ml/). Free and
         in-process: no cloud service, no Python. -->
    <PackageReference Include="Microsoft.ML" Version="4.0.3" />
    <PackageReference Include="Microsoft.ML.FastTree" Version="4.0.3" />
    <PackageReference Include="Microsoft.ML.TimeSeries" Version="4.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- The trained forecast model and its evaluation travel inside the assembly,
         like the report logo, so a Railway deploy always has them. A retrained
         model written to Ml:ModelPath takes precedence at runtime. -->
    <EmbeddedResource Include="Ml/moisture-model.zip" LogicalName="AgroFlow.Api.Ml.moisture-model.zip" Condition="Exists('Ml/moisture-model.zip')" />
    <EmbeddedResource Include="Ml/moisture-model-evaluation.json" LogicalName="AgroFlow.Api.Ml.moisture-model-evaluation.json" Condition="Exists('Ml/moisture-model-evaluation.json')" />
    <None Remove="Ml/training-weather/**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reuses Zone.cs etc. as-is. AgroFlow.Domain is an Exe (console demo
         project, untouched), not a class library - referencing it from another
         project still works fine in .NET, it just means AgroFlow.Domain.dll/exe
         rides along in this project's output folder as an unused runtime
         dependency. -->
    <ProjectReference Include="../AgroFlow.Domain/AgroFlow.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The report's logo, compiled into the assembly rather than deployed
         beside it. A Railway container's filesystem is rebuilt on every
         deploy and nothing copies loose assets into it, so a report that
         loaded this from disk would quietly lose its header in production -
         and only in production. -->
    <EmbeddedResource Include="Reports/Assets/agroflow-icon.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- The report builders in Reports/ are internal: they are an
         implementation detail of three endpoints, not API surface. The test
         project still has to exercise them, because a malformed chart does
         not throw - Skia renders a blank box and the document "succeeds", so
         a broken report would ship looking like a layout choice. -->
    <InternalsVisibleTo Include="AgroFlow.Domain.Tests" />
  </ItemGroup>

</Project>
