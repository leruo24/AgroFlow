<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Adjust to match your installed .NET SDK if different -->
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <StartupObject>AgroFlow.Presentation.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <!-- Postgres provider for the Supabase backend. Confirmed current stable: 10.0.3 -->
    <PackageReference Include="Npgsql" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- The FAO-56 knowledge base travels inside the assembly rather than as a
         content file, so a deployment can never end up running with the values
         missing and the Railway Docker image needs no copy step. Read by
         Agronomy/Fao56Knowledge.cs via GetManifestResourceStream; the logical
         resource name is AgroFlow.Domain.Agronomy.fao56-crop-knowledge.json. -->
    <EmbeddedResource Include="Agronomy\fao56-crop-knowledge.json" />
  </ItemGroup>

</Project>
