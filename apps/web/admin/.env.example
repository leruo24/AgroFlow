# Supabase project connection - all dashboard reads/writes go straight
# to Postgres via this, scoped by Row Level Security. There is no mock
# data mode; both of these are required.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# AgroFlow.Api host (backend/AgroFlow.Api) - farmer onboarding calls go
# here only (see the Architecture section of the root README.md for what
# does and doesn't go through the API). Deployed on Railway, so no local dotnet run is needed for
# day-to-day work. Point this at http://localhost:5080 (the dev port per
# Properties/launchSettings.json, not 5000) only to debug the API locally.
VITE_AGROFLOW_API_BASE=https://agroflow-production-998d.up.railway.app

# Shown in the landing page's "Get the app" section. Each link is hidden
# entirely when its variable is empty, so the page is correct before the files
# exist - a Download button that 404s is worse than no button.
#
# Android: a direct link to the .apk (a GitHub release asset is the simplest
# host). iPhone: the mobile web app's URL, which users add to their home
# screen - an APK cannot install on iOS and a real iOS build needs a paid
# Apple Developer account.
VITE_DOWNLOADS_ANDROID_APK_URL=
VITE_DOWNLOADS_WEB_APP_URL=
