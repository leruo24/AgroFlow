# Supabase project connection - all dashboard reads/writes go straight
# to Postgres via this, scoped by Row Level Security. There is no mock
# data mode; both of these are required.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# AgroFlow.Api host (backend/AgroFlow.Api) - farmer onboarding calls go
# here only (see docs/ORIENTATION.md #4 for what does/doesn't go through
# the API). Default dev port per Properties/launchSettings.json is 5080,
# not 5000.
VITE_AGROFLOW_API_BASE=http://localhost:5080
