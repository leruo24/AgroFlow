# Supabase project connection.
# Expo only inlines env vars prefixed EXPO_PUBLIC_ into the client bundle -
# see https://docs.expo.dev/guides/environment-variables/
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# During Expo development the app derives the LAN host from Expo and only
# needs the backend port. A deployed build should instead set the full HTTPS
# URL in EXPO_PUBLIC_AGROFLOW_API_BASE.
EXPO_PUBLIC_AGROFLOW_API_PORT=5080
# EXPO_PUBLIC_AGROFLOW_API_BASE=https://api.your-domain.example
