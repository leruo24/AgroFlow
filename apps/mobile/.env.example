# Supabase project connection.
# Expo only inlines env vars prefixed EXPO_PUBLIC_ into the client bundle -
# see https://docs.expo.dev/guides/environment-variables/
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# AgroFlow.Api base URL. The API is deployed on Railway, so this value is the
# same for everyone and is network-independent - there is no LAN IP to update
# when you change Wi-Fi. https, no trailing slash, no port.
EXPO_PUBLIC_AGROFLOW_API_BASE=https://agroflow-production-998d.up.railway.app

# Fallback only. If EXPO_PUBLIC_AGROFLOW_API_BASE is unset, the app derives a
# LAN host from Expo and appends this port (see src/services/agroFlowApi.ts,
# resolveApiBase). Only relevant when running the backend locally.
EXPO_PUBLIC_AGROFLOW_API_PORT=5080
